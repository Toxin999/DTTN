; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DetectiveNet"
config/description="Detective game set inside a fictional 2002 desktop OS."
run/main_scene="res://scenes/main.tscn"
run/low_processor_mode=true
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://src/core/settings.gd"
WorldClock="*res://src/core/world_clock.gd"
Flags="*res://src/core/flags.gd"
NetSim="*res://src/core/net_sim.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/subwindows/embed_subwindows=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
